{
  "name": "dsh-video-kit",
  "version": "0.1.1",
  "description": "DSH 视频理解：把 B站链接或本地视频拆成字幕时间线 + 内容分组 + 可回查网格页。内置 video-understanding-kit（TransNetV2 镜头检测 + PP-OCRv4 字幕），模型随包附带，零外部服务。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "id": "dsh-video-kit",
    "name": "视频理解工具包",
    "version": "0.1.1",
    "permissions": "工具注册, DSH storages 数据目录读写, 本机进程调用（ffmpeg / pipeline）",
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "harness:check": "node --check index.js",
    "models": "node lib/videokit/download-models.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "^1.22.0"
  }
}
