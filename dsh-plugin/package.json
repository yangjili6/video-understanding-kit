{
  "name": "dsh-video-kit",
  "version": "0.1.4",
  "description": "DSH 视频理解插件：本地/B站视频分析、字幕时间线、镜头分组与可回查网格；视觉模型需单独下载。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "dsh": {
    "id": "dsh-video-kit",
    "name": "视频理解工具包",
    "version": "0.1.4",
    "permissions": "工具注册，侧栏面板与面板配置读写（/dsh-video-kit-api），DSH storages 数据目录读写，本机进程调用（ffmpeg / pipeline），网络访问（B站短链解析及视频下载）",
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "harness:check": "node --check index.js",
    "models": "node lib/videokit/download-models.mjs"
  },
  "dependencies": {
    "onnxruntime-web": "^1.22.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/yangjili6/video-understanding-kit.git"
  },
  "disclosure": {
    "cloud": true,
    "network": [
      "https://b23.tv/",
      "https://api.bilibili.com/",
      "https://*.bilivideo.com/",
      "https://huggingface.co/",
      "https://raw.githubusercontent.com/"
    ],
    "offlineMode": true,
    "apiKeys": [],
    "permissions": [
      "Read user-selected local video files",
      "Write analysis output under DSH storages/dsh-video-kit",
      "Run ffmpeg and ImageMagick locally",
      "Fetch Bilibili metadata/video when a Bilibili URL is supplied",
      "Download local inference models during setup"
    ]
  }
}
