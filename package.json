{
  "name": "video-understanding-kit",
  "version": "0.3.4",
  "description": "视频理解流水线：采样、镜头分组、网格去重、字幕图像条带与可选 ASR",
  "type": "module",
  "scripts": {
    "models": "node download-models.mjs",
    "preview": "node serve-preview.mjs",
    "sync": "node scripts/sync-videokit.mjs",
    "sync:check": "node scripts/sync-videokit.mjs --check",
    "pack:check": "node scripts/check-pack-files.mjs",
    "check": "node scripts/check-pack-files.mjs && node scripts/sync-videokit.mjs --check"
  },
  "dependencies": {
    "onnxruntime-web": "^1.22.0"
  }
}
